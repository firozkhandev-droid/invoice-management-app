# Copy this file to .env.offline for personal offline use.
# The SQLite file is created under prisma/offline.db by Prisma because schema.offline.prisma lives in prisma/.
DATABASE_URL=file:./offline.db
UPLOAD_DIR=offline-data/uploads
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
AUTH_SECRET=offline-personal-auth-secret-change-me

# Base64 for 32 bytes. Change this before storing real bank details.
BANK_FIELD_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
