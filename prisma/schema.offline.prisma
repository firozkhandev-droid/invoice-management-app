// This file is generated by scripts/prepare-offline-schema.mjs.
// Edit prisma/schema.prisma, then run npm run offline:schema.
generator client {
  provider      = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  name            String?
  passwordHash    String   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  sessions      Session[]
  memberships   OrganisationMember[]
  invitations   OrganisationInvitation[] @relation("InvitationInviter")
  auditLogs     AuditLog[]
  lockedPeriods LockedPeriod[] @relation("LockedPeriodCreator")
  invoiceNumberVoids InvoiceNumberVoid[] @relation("InvoiceNumberVoidCreator")
  createdInvoices Invoice[] @relation("InvoiceCreator")
  updatedInvoices Invoice[] @relation("InvoiceUpdater")
  issuedInvoices Invoice[] @relation("InvoiceIssuer")
  cancelledInvoices Invoice[] @relation("InvoiceCanceller")
  invoiceRevisions InvoiceRevision[]
  createdCreditNotes CreditNote[] @relation("CreditNoteCreator")
  updatedCreditNotes CreditNote[] @relation("CreditNoteUpdater")
  issuedCreditNotes CreditNote[] @relation("CreditNoteIssuer")
  createdPackingLists PackingList[] @relation("PackingListCreator")
  updatedPackingLists PackingList[] @relation("PackingListUpdater")
  issuedPackingLists PackingList[] @relation("PackingListIssuer")
  generatedDocuments GeneratedDocument[]
  createdPayments Payment[] @relation("PaymentCreator")
  reversedPayments Payment[] @relation("PaymentReverser")

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  tokenHash    String   @unique @map("token_hash")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique @map("token_hash")
  purpose   String
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, purpose, expiresAt])
  @@map("verification_tokens")
}

model Organisation {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  locale             String   @default("en-IN")
  timeZone           String   @default("Asia/Kolkata") @map("time_zone")
  defaultCurrency    String   @default("INR") @map("default_currency")
  financialYearStart Int      @default(4) @map("financial_year_start")
  planStatus         String   @default("trial") @map("plan_status")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  members     OrganisationMember[]
  invitations OrganisationInvitation[]
  auditLogs   AuditLog[]
  fileAssets  FileAsset[]
  companies   Company[]
  bankAccounts CompanyBankAccount[]
  buyers Buyer[]
  buyerAddresses BuyerAddress[]
  units Unit[]
  taxRates TaxRate[]
  items Item[]
  settings OrganisationSettings?
  lockedPeriods LockedPeriod[]
  invoiceNumberSeries InvoiceNumberSeries[]
  creditNoteNumberSeries CreditNoteNumberSeries[]
  invoiceNumberVoids InvoiceNumberVoid[]
  invoices Invoice[]
  invoiceItems InvoiceItem[]
  invoiceRevisions InvoiceRevision[]
  creditNotes CreditNote[]
  creditNoteLines CreditNoteLine[]
  packingLists PackingList[]
  packingListLines PackingListLine[]
  generatedDocuments GeneratedDocument[]
  payments Payment[]
  paymentAllocations PaymentAllocation[]

  @@map("organisations")
}

model OrganisationMember {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  userId         String   @map("user_id")
  role           MemberRole
  status         MemberStatus @default(active)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId, status])
  @@map("organisation_members")
}

model OrganisationInvitation {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  email          String
  role           MemberRole
  tokenHash      String   @unique @map("token_hash")
  invitedById    String   @map("invited_by_id")
  acceptedAt     DateTime? @map("accepted_at")
  revokedAt      DateTime? @map("revoked_at")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([organisationId, email])
  @@map("organisation_invitations")
}

model AuditLog {
  id             String   @id @default(uuid())
  organisationId String?  @map("organisation_id")
  actorUserId    String?  @map("actor_user_id")
  action         String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation? @relation(fields: [organisationId], references: [id])
  actor        User?         @relation(fields: [actorUserId], references: [id])

  @@index([organisationId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model FileAsset {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  kind           String
  originalName   String   @map("original_name")
  storageKey     String   @unique @map("storage_key")
  mimeType       String   @map("mime_type")
  byteSize       Int      @map("byte_size")
  checksumSha256 String   @map("checksum_sha256")
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  companyLogos Company[] @relation("CompanyLogo")
  companySignatures Company[] @relation("CompanySignature")

  @@index([organisationId, kind])
  @@map("file_assets")
}

model Company {
  id                    String   @id @default(uuid())
  organisationId        String   @map("organisation_id")
  legalName             String   @map("legal_name")
  tradingName           String?  @map("trading_name")
  addressLine1          String   @map("address_line_1")
  addressLine2          String?  @map("address_line_2")
  city                  String
  state                 String
  stateCode             String?  @map("state_code")
  postcode              String
  country               String   @default("India")
  phone                 String?
  email                 String?
  gstin                 String?
  pan                   String?
  iec                   String?
  taxIdentifiers        Json?    @map("tax_identifiers")
  logoAssetId           String?  @map("logo_asset_id")
  signatureAssetId      String?  @map("signature_asset_id")
  signatoryName         String?  @map("signatory_name")
  signatoryDesignation  String?  @map("signatory_designation")
  defaultDeclaration    String?  @map("default_declaration")
  defaultTerms          String?  @map("default_terms")
  isDefault             Boolean  @default(false) @map("is_default")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  logoAsset      FileAsset?   @relation("CompanyLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  signatureAsset FileAsset?   @relation("CompanySignature", fields: [signatureAssetId], references: [id], onDelete: SetNull)
  bankAccounts   CompanyBankAccount[]
  settingsDefaultFor OrganisationSettings[] @relation("SettingsDefaultCompany")
  invoiceNumberSeries InvoiceNumberSeries[]
  creditNoteNumberSeries CreditNoteNumberSeries[]
  invoices Invoice[]
  packingLists PackingList[]

  @@index([organisationId, isActive])
  @@index([organisationId, isDefault])
  @@map("companies")
}

model CompanyBankAccount {
  id                       String   @id @default(uuid())
  organisationId           String   @map("organisation_id")
  companyId                String   @map("company_id")
  bankName                 String   @map("bank_name")
  accountHolderName        String   @map("account_holder_name")
  accountNumberCiphertext  String   @map("account_number_ciphertext")
  accountNumberIv          String   @map("account_number_iv")
  accountNumberTag         String   @map("account_number_tag")
  accountNumberLast4       String   @map("account_number_last4")
  ifsc                     String?
  swiftBic                 String?  @map("swift_bic")
  branchCode               String?  @map("branch_code")
  branchName               String?  @map("branch_name")
  branchAddress            String?  @map("branch_address")
  currency                 String   @default("INR")
  isDefault                Boolean  @default(false) @map("is_default")
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  settingsDefaultFor OrganisationSettings[] @relation("SettingsDefaultBankAccount")
  invoices Invoice[]
  payments Payment[]

  @@index([organisationId, companyId, isActive])
  @@index([organisationId, isDefault])
  @@map("company_bank_accounts")
}

model Buyer {
  id                String   @id @default(uuid())
  organisationId    String   @map("organisation_id")
  displayName       String   @map("display_name")
  legalName         String?  @map("legal_name")
  contactPerson     String?  @map("contact_person")
  phone             String?
  email             String?
  gstin             String?
  pan               String?
  iec               String?
  customerReference String?  @map("customer_reference")
  taxIdentifiers    Json?    @map("tax_identifiers")
  notes             String?
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  addresses    BuyerAddress[]
  invoices Invoice[]
  consigneeInvoices Invoice[] @relation("InvoiceConsigneeBuyer")
  packingLists PackingList[] @relation("PackingListBuyer")
  consigneePackingLists PackingList[] @relation("PackingListConsigneeBuyer")

  @@index([organisationId, isActive])
  @@index([organisationId, displayName])
  @@map("buyers")
}

model BuyerAddress {
  id               String   @id @default(uuid())
  organisationId   String   @map("organisation_id")
  buyerId          String   @map("buyer_id")
  label            String
  contactPerson    String?  @map("contact_person")
  phone            String?
  email            String?
  addressLine1     String   @map("address_line_1")
  addressLine2     String?  @map("address_line_2")
  city             String
  state            String
  stateCode        String?  @map("state_code")
  postcode         String
  country          String   @default("India")
  isBillingDefault Boolean  @default(false) @map("is_billing_default")
  isShippingDefault Boolean @default(false) @map("is_shipping_default")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  buyer        Buyer        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  billingInvoices Invoice[] @relation("InvoiceBillingAddress")
  shippingInvoices Invoice[] @relation("InvoiceShippingAddress")

  @@index([organisationId, buyerId, isActive])
  @@index([organisationId, buyerId, isBillingDefault])
  @@index([organisationId, buyerId, isShippingDefault])
  @@map("buyer_addresses")
}

model Unit {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  code           String
  name           String
  precision      Int      @default(2)
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  items        Item[]

  @@unique([organisationId, code])
  @@index([organisationId, isActive])
  @@index([organisationId, isDefault])
  @@map("units")
}

model TaxRate {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  name           String
  rate           Decimal
  taxType        TaxType  @default(gst) @map("tax_type")
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  items        Item[]

  @@index([organisationId, isActive])
  @@index([organisationId, isDefault])
  @@map("tax_rates")
}

model Item {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  sku            String?
  name           String
  description    String?
  category       String?
  subcategory    String?
  hsnSac         String?  @map("hsn_sac")
  manufacturer   String?
  barcode        String?
  weightKg       Decimal? @map("weight_kg")
  unitId         String?  @map("unit_id")
  taxRateId      String?  @map("tax_rate_id")
  saleRate       Decimal? @map("sale_rate")
  currency       String   @default("INR")
  imageAssetId   String?  @map("image_asset_id")
  imageStatus    String   @default("pending") @map("image_status")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  unit         Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  taxRate      TaxRate?     @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  invoiceItems InvoiceItem[]
  packingListLines PackingListLine[]

  @@unique([organisationId, sku])
  @@index([organisationId, isActive])
  @@index([organisationId, category])
  @@index([organisationId, barcode])
  @@index([organisationId, name])
  @@map("items")
}

model OrganisationSettings {
  id                         String         @id @default(uuid())
  organisationId             String         @unique @map("organisation_id")
  defaultCompanyId           String?        @map("default_company_id")
  defaultBankAccountId       String?        @map("default_bank_account_id")
  defaultInvoiceTitle        String         @default("Tax Invoice") @map("default_invoice_title")
  defaultTaxMode             TaxMode        @default(automatic) @map("default_tax_mode")
  roundingPolicy             RoundingPolicy @default(nearest_rupee) @map("rounding_policy")
  defaultDeclaration         String?        @map("default_declaration")
  defaultNotes               String?        @map("default_notes")
  paymentTerms               String?        @map("payment_terms")
  deliveryTerms              String?        @map("delivery_terms")
  pdfFooter                  String?        @map("pdf_footer")
  showPageNumbers            Boolean        @default(true) @map("show_page_numbers")
  draftAutosave              Boolean        @default(true) @map("draft_autosave")
  numberOnIssue              Boolean        @default(true) @map("number_on_issue")
  allowManualNumberOverride  Boolean        @default(false) @map("allow_manual_number_override")
  allowManualDateOverride    Boolean        @default(false) @map("allow_manual_date_override")
  createdAt                  DateTime       @default(now()) @map("created_at")
  updatedAt                  DateTime       @updatedAt @map("updated_at")

  organisation       Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  defaultCompany     Company?            @relation("SettingsDefaultCompany", fields: [defaultCompanyId], references: [id], onDelete: SetNull)
  defaultBankAccount CompanyBankAccount? @relation("SettingsDefaultBankAccount", fields: [defaultBankAccountId], references: [id], onDelete: SetNull)

  @@map("organisation_settings")
}

model LockedPeriod {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  name           String
  startsOn       DateTime @map("starts_on")
  endsOn         DateTime @map("ends_on")
  reason         String
  isActive       Boolean  @default(true) @map("is_active")
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("LockedPeriodCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organisationId, startsOn, endsOn])
  @@index([organisationId, isActive])
  @@map("locked_periods")
}

model InvoiceNumberSeries {
  id             String          @id @default(uuid())
  organisationId String          @map("organisation_id")
  companyId      String?         @map("company_id")
  name           String
  pattern        String
  prefix         String?
  padding        Int             @default(4)
  startingNumber Int             @default(1) @map("starting_number")
  nextSequence   Int             @default(1) @map("next_sequence")
  resetRule      SeriesResetRule @default(financial_year) @map("reset_rule")
  lastResetKey   String?         @map("last_reset_key")
  isDefault      Boolean         @default(false) @map("is_default")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  invoices     Invoice[]
  voids        InvoiceNumberVoid[]

  @@index([organisationId, companyId, isActive])
  @@index([organisationId, isDefault])
  @@map("invoice_number_series")
}

model CreditNoteNumberSeries {
  id             String          @id @default(uuid())
  organisationId String          @map("organisation_id")
  companyId      String?         @map("company_id")
  name           String
  pattern        String
  prefix         String?
  padding        Int             @default(4)
  startingNumber Int             @default(1) @map("starting_number")
  nextSequence   Int             @default(1) @map("next_sequence")
  resetRule      SeriesResetRule @default(financial_year) @map("reset_rule")
  lastResetKey   String?         @map("last_reset_key")
  isDefault      Boolean         @default(false) @map("is_default")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  creditNotes  CreditNote[]

  @@index([organisationId, companyId, isActive])
  @@index([organisationId, isDefault])
  @@map("credit_note_number_series")
}

model InvoiceNumberVoid {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  seriesId       String   @map("series_id")
  sequenceNumber Int      @map("sequence_number")
  invoiceNumber  String   @map("invoice_number")
  reason         String
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  series       InvoiceNumberSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  createdBy    User                @relation("InvoiceNumberVoidCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organisationId, invoiceNumber])
  @@unique([seriesId, sequenceNumber])
  @@index([organisationId, createdAt])
  @@map("invoice_number_voids")
}

model Invoice {
  id                    String        @id @default(uuid())
  organisationId        String        @map("organisation_id")
  companyId             String?       @map("company_id")
  buyerId               String?       @map("buyer_id")
  consigneeBuyerId      String?       @map("consignee_buyer_id")
  billingAddressId      String?       @map("billing_address_id")
  shippingAddressId     String?       @map("shipping_address_id")
  bankAccountId         String?       @map("bank_account_id")
  status                InvoiceStatus @default(draft)
  seriesId              String?       @map("series_id")
  invoiceNumber         String?       @map("invoice_number")
  sequenceNumber        Int?          @map("sequence_number")
  invoiceDate           DateTime      @map("invoice_date")
  dueDate               DateTime?     @map("due_date")
  financialYear         String?       @map("financial_year")
  currency              String        @default("INR")
  placeOfSupplyStateCode String?      @map("place_of_supply_state_code")
  taxMode               TaxMode       @default(automatic) @map("tax_mode")
  buyerOrderNumber      String?       @map("buyer_order_number")
  buyerOrderDate        DateTime?     @map("buyer_order_date")
  exporterReference     String?       @map("exporter_reference")
  preCarriageBy         String?       @map("pre_carriage_by")
  placeOfReceipt        String?       @map("place_of_receipt")
  vesselFlightNo        String?       @map("vessel_flight_no")
  portOfLoading         String?       @map("port_of_loading")
  portOfDischarge       String?       @map("port_of_discharge")
  finalDestination      String?       @map("final_destination")
  termsOfDelivery       String?       @map("terms_of_delivery")
  notes                 String?
  declaration           String?
  subtotal              Decimal       @default(0)
  invoiceDiscount       Decimal       @default(0) @map("invoice_discount")
  otherCharges          Decimal       @default(0) @map("other_charges")
  taxableTotal          Decimal       @default(0) @map("taxable_total")
  igstTotal             Decimal       @default(0) @map("igst_total")
  cgstTotal             Decimal       @default(0) @map("cgst_total")
  sgstTotal             Decimal       @default(0) @map("sgst_total")
  roundOff              Decimal       @default(0) @map("round_off")
  grandTotal            Decimal       @default(0) @map("grand_total")
  paidTotal             Decimal       @default(0) @map("paid_total")
  balanceDue            Decimal       @default(0) @map("balance_due")
  version               Int           @default(1)
  companySnapshot       Json?         @map("company_snapshot")
  buyerSnapshot         Json?         @map("buyer_snapshot")
  consigneeSnapshot     Json?         @map("consignee_snapshot")
  bankSnapshot          Json?         @map("bank_snapshot")
  calculationSnapshot   Json?         @map("calculation_snapshot")
  documentSnapshot      Json?         @map("document_snapshot")
  createdById           String        @map("created_by_id")
  updatedById           String?       @map("updated_by_id")
  issuedById            String?       @map("issued_by_id")
  issuedAt              DateTime?     @map("issued_at")
  cancelledById         String?       @map("cancelled_by_id")
  cancelledAt           DateTime?     @map("cancelled_at")
  cancellationReason    String?       @map("cancellation_reason")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  organisation    Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  series          InvoiceNumberSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  company         Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  buyer           Buyer?              @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  consigneeBuyer  Buyer?              @relation("InvoiceConsigneeBuyer", fields: [consigneeBuyerId], references: [id], onDelete: SetNull)
  billingAddress  BuyerAddress?       @relation("InvoiceBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  shippingAddress BuyerAddress?       @relation("InvoiceShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  bankAccount     CompanyBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  createdBy       User                @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User?               @relation("InvoiceUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  issuedBy        User?               @relation("InvoiceIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  cancelledBy     User?               @relation("InvoiceCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  items           InvoiceItem[]
  revisions       InvoiceRevision[]
  documents       GeneratedDocument[]
  paymentAllocations PaymentAllocation[]
  creditNotes CreditNote[] @relation("OriginalInvoiceCreditNotes")
  packingLists PackingList[]

  @@index([organisationId, status, invoiceDate])
  @@index([organisationId, buyerId])
  @@index([organisationId, invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  invoiceId      String   @map("invoice_id")
  itemId         String?  @map("item_id")
  sortOrder      Int      @map("sort_order")
  sku            String?
  description    String
  hsnSac         String?  @map("hsn_sac")
  quantity       Decimal
  unitCode       String?  @map("unit_code")
  rate           Decimal
  discountAmount Decimal  @default(0) @map("discount_amount")
  taxableAmount  Decimal  @default(0) @map("taxable_amount")
  gstRate        Decimal  @default(0) @map("gst_rate")
  igstAmount     Decimal  @default(0) @map("igst_amount")
  cgstAmount     Decimal  @default(0) @map("cgst_amount")
  sgstAmount     Decimal  @default(0) @map("sgst_amount")
  lineTotal      Decimal  @default(0) @map("line_total")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item         Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  creditNoteLines CreditNoteLine[]
  packingListLines PackingListLine[]

  @@index([organisationId, invoiceId, sortOrder])
  @@map("invoice_items")
}

model PackingList {
  id               String            @id @default(uuid())
  organisationId   String            @map("organisation_id")
  invoiceId        String?           @map("invoice_id")
  companyId        String?           @map("company_id")
  buyerId          String?           @map("buyer_id")
  consigneeBuyerId String?           @map("consignee_buyer_id")
  status           PackingListStatus @default(draft)
  packingListNumber String?          @map("packing_list_number")
  sequenceNumber   Int?              @map("sequence_number")
  packingListDate  DateTime          @map("packing_list_date")
  exportReference  String?           @map("export_reference")
  containerNumber  String?           @map("container_number")
  sealNumber       String?           @map("seal_number")
  shipmentMode     String?           @map("shipment_mode")
  portOfLoading    String?           @map("port_of_loading")
  portOfDischarge  String?           @map("port_of_discharge")
  finalDestination String?           @map("final_destination")
  totalPackages    Int               @default(0) @map("total_packages")
  totalQuantity    Decimal           @default(0) @map("total_quantity")
  totalNetWeightKg Decimal           @default(0) @map("total_net_weight_kg")
  totalGrossWeightKg Decimal         @default(0) @map("total_gross_weight_kg")
  totalVolumeCbm   Decimal           @default(0) @map("total_volume_cbm")
  notes            String?
  version          Int               @default(1)
  createdById      String            @map("created_by_id")
  updatedById      String?           @map("updated_by_id")
  issuedById       String?           @map("issued_by_id")
  issuedAt         DateTime?         @map("issued_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  invoice         Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  buyer           Buyer?       @relation("PackingListBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  consigneeBuyer  Buyer?       @relation("PackingListConsigneeBuyer", fields: [consigneeBuyerId], references: [id], onDelete: SetNull)
  createdBy       User         @relation("PackingListCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User?        @relation("PackingListUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  issuedBy        User?        @relation("PackingListIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  lines           PackingListLine[]

  @@unique([organisationId, packingListNumber])
  @@index([organisationId, status, packingListDate])
  @@index([organisationId, invoiceId])
  @@map("packing_lists")
}

model PackingListLine {
  id              String   @id @default(uuid())
  organisationId  String   @map("organisation_id")
  packingListId   String   @map("packing_list_id")
  itemId          String?  @map("item_id")
  invoiceItemId   String?  @map("invoice_item_id")
  sortOrder       Int      @map("sort_order")
  packageNo       String?  @map("package_no")
  marksAndNumbers String?  @map("marks_and_numbers")
  sku             String?
  description     String
  hsnSac          String?  @map("hsn_sac")
  quantity        Decimal
  unitCode        String?  @map("unit_code")
  netWeightKg     Decimal  @default(0) @map("net_weight_kg")
  grossWeightKg   Decimal  @default(0) @map("gross_weight_kg")
  lengthCm        Decimal? @map("length_cm")
  widthCm         Decimal? @map("width_cm")
  heightCm        Decimal? @map("height_cm")
  volumeCbm       Decimal  @default(0) @map("volume_cbm")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  packingList  PackingList  @relation(fields: [packingListId], references: [id], onDelete: Cascade)
  item          Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  invoiceItem   InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)

  @@index([organisationId, packingListId, sortOrder], map: "pl_lines_org_pl_sort_idx")
  @@index([organisationId, invoiceItemId], map: "pl_lines_org_invoice_item_idx")
  @@map("packing_list_lines")
}

model InvoiceRevision {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  invoiceId      String   @map("invoice_id")
  revisionNumber Int      @map("revision_number")
  reason         String
  snapshot       Json
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([invoiceId, revisionNumber])
  @@index([organisationId, invoiceId])
  @@map("invoice_revisions")
}

model CreditNote {
  id                    String           @id @default(uuid())
  organisationId        String           @map("organisation_id")
  originalInvoiceId     String           @map("original_invoice_id")
  status                CreditNoteStatus @default(draft)
  seriesId              String?          @map("series_id")
  creditNoteNumber      String?          @map("credit_note_number")
  sequenceNumber        Int?             @map("sequence_number")
  creditNoteDate        DateTime         @map("credit_note_date")
  financialYear         String?          @map("financial_year")
  reason                String?
  currency              String           @default("INR")
  subtotal              Decimal          @default(0)
  taxableTotal          Decimal          @default(0) @map("taxable_total")
  igstTotal             Decimal          @default(0) @map("igst_total")
  cgstTotal             Decimal          @default(0) @map("cgst_total")
  sgstTotal             Decimal          @default(0) @map("sgst_total")
  roundOff              Decimal          @default(0) @map("round_off")
  grandTotal            Decimal          @default(0) @map("grand_total")
  originalInvoiceSnapshot Json           @map("original_invoice_snapshot")
  createdById           String           @map("created_by_id")
  updatedById           String?          @map("updated_by_id")
  issuedById            String?          @map("issued_by_id")
  issuedAt              DateTime?        @map("issued_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  originalInvoice Invoice      @relation("OriginalInvoiceCreditNotes", fields: [originalInvoiceId], references: [id], onDelete: Restrict)
  series          CreditNoteNumberSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdBy       User         @relation("CreditNoteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User?        @relation("CreditNoteUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  issuedBy        User?        @relation("CreditNoteIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  lines           CreditNoteLine[]
  documents       GeneratedDocument[] @relation("CreditNoteDocuments")

  @@index([organisationId, status, creditNoteDate])
  @@index([organisationId, originalInvoiceId])
  @@index([organisationId, creditNoteNumber])
  @@map("credit_notes")
}

model CreditNoteLine {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  creditNoteId   String   @map("credit_note_id")
  invoiceItemId  String?  @map("invoice_item_id")
  sortOrder      Int      @map("sort_order")
  sku            String?
  description    String
  hsnSac         String?  @map("hsn_sac")
  quantity       Decimal
  unitCode       String?  @map("unit_code")
  rate           Decimal
  discountAmount Decimal  @default(0) @map("discount_amount")
  taxableAmount  Decimal  @default(0) @map("taxable_amount")
  gstRate        Decimal  @default(0) @map("gst_rate")
  igstAmount     Decimal  @default(0) @map("igst_amount")
  cgstAmount     Decimal  @default(0) @map("cgst_amount")
  sgstAmount     Decimal  @default(0) @map("sgst_amount")
  lineTotal      Decimal  @default(0) @map("line_total")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  creditNote   CreditNote   @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoiceItem  InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)

  @@index([organisationId, creditNoteId, sortOrder])
  @@index([organisationId, invoiceItemId])
  @@map("credit_note_lines")
}

model GeneratedDocument {
  id              String   @id @default(uuid())
  organisationId  String   @map("organisation_id")
  invoiceId       String   @map("invoice_id")
  creditNoteId    String?  @map("credit_note_id")
  documentType    String   @map("document_type")
  templateVersion String   @map("template_version")
  storageKey      String?  @map("storage_key")
  checksumSha256  String?  @map("checksum_sha256")
  generatedAt     DateTime @default(now()) @map("generated_at")
  generatedById   String   @map("generated_by_id")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  creditNote   CreditNote?  @relation("CreditNoteDocuments", fields: [creditNoteId], references: [id], onDelete: Restrict)
  generatedBy  User         @relation(fields: [generatedById], references: [id], onDelete: Restrict)

  @@index([organisationId, invoiceId])
  @@index([organisationId, creditNoteId])
  @@map("generated_documents")
}

model Payment {
  id                String        @id @default(uuid())
  organisationId    String        @map("organisation_id")
  paymentDate       DateTime      @map("payment_date")
  amount            Decimal
  currency          String        @default("INR")
  paymentMethod     String        @map("payment_method")
  referenceNumber   String?       @map("reference_number")
  bankAccountId     String?       @map("bank_account_id")
  notes             String?
  status            PaymentStatus @default(posted)
  idempotencyKey    String?       @map("idempotency_key")
  createdById       String        @map("created_by_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  reversedById      String?       @map("reversed_by_id")
  reversedAt        DateTime?     @map("reversed_at")
  reversalReason    String?       @map("reversal_reason")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  bankAccount  CompanyBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  createdBy    User @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reversedBy   User? @relation("PaymentReverser", fields: [reversedById], references: [id], onDelete: SetNull)
  allocations  PaymentAllocation[]

  @@unique([organisationId, idempotencyKey])
  @@index([organisationId, paymentDate])
  @@index([organisationId, status])
  @@map("payments")
}

model PaymentAllocation {
  id             String   @id @default(uuid())
  organisationId String   @map("organisation_id")
  paymentId      String   @map("payment_id")
  invoiceId      String   @map("invoice_id")
  amount         Decimal
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([organisationId, invoiceId])
  @@index([organisationId, paymentId])
  @@map("payment_allocations")
}

enum TaxType {
  gst
  export_zero_rated
  no_tax
}

enum TaxMode {
  automatic
  igst
  cgst_sgst
  zero_rated_export
  no_tax
}

enum RoundingPolicy {
  none
  nearest_rupee
  two_decimals
}

enum SeriesResetRule {
  never
  calendar_year
  financial_year
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  cancelled
  amended
}

enum PaymentStatus {
  posted
  reversed
}

enum CreditNoteStatus {
  draft
  issued
  cancelled
}

enum PackingListStatus {
  draft
  issued
  cancelled
}

enum MemberRole {
  owner
  admin
  accountant
  viewer
}

enum MemberStatus {
  active
  invited
  suspended
}
